# 复制成 .env 即可: cp .env.example .env
# 本地裸跑(不用 Docker)时把 db 换成 localhost

# --- 数据库 ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
# 端口是 5433 不是默认 5432: 本机 Homebrew postgresql@17 占着 5432, 本项目的
# Docker Postgres 让路 (docker-compose.yml 里宿主机侧映射到 5433, 容器内仍是 5432)
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5433/sentinel

# --- 运行时 ---
SENTINEL_APPLY_DEV_SEED=true        # 启动写入演示门店/传感器/员工/登录账号
SENTINEL_HEARTBEAT_TIMEOUT_SECONDS=60
# environment 非 development 时: 默认 JWT 密钥会拒绝启动, 会话 cookie 加 Secure (SPEC-004)
SENTINEL_ENVIRONMENT=development
SENTINEL_JWT_SECRET=dev-only-change-me

# --- 演示登录账号 (种子写入, 仅演示用) ---
# admin@example.com  (admin, 不绑现场员工)
# chris@example.com  (manager, 绑员工 Chris Li)
# alex@example.com   (operator, 绑员工 Alex Chen)
# 三个账号的密码统一为: sentinel-demo

# --- LLM (W4 起需要, W1 留空即可) ---
# 火山方舟(豆包), OpenAI 兼容协议; 换 DeepSeek/OpenAI 只需改 BASE_URL + MODEL
# key 用 `read -rs` 读入再写进 .env, 不上屏、不进终端历史 (CLAUDE.md 协作红线)
SENTINEL_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_MODEL=doubao-seed-2-1-pro-260628
# 刊例单价, 人民币元/百万 token (2026-08 实测; 币种与列名的债见 SPEC-002 第九节末)
SENTINEL_LLM_PRICE_INPUT_PER_MTOK=6.00
SENTINEL_LLM_PRICE_OUTPUT_PER_MTOK=30.00
